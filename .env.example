# ==========================================
# متغيرات البيئة لإرسال الإيميلات (Next.js & Vercel)
# ==========================================

# البريد المستلم لإشعارات الطلبات والطلبات المتروكة
# قائمة مفصولة بفواصل — مثال: ADMIN_EMAIL="a@gmail.com, b@gmail.com"
# العنوان shaimadjiab1997@gmail.com يُضاف تلقائياً دائماً حتى لو لم يُذكر هنا
ADMIN_EMAIL="shaimadjiab1997@gmail.com"

# خادم البريد (SMTP) - مثال Gmail:
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"

# حساب بريدك Gmail المرسل (مطلوب)
SMTP_USER="you@gmail.com"

# كلمة مرور التطبيقات من جوجل (Google App Password) - مكونة من 16 حرفاً (مطلوب)
# للحصول عليها: ادخل على حساب Google الخاص بك > الأمان (Security) > التحقق بخطوتين (2-Step Verification) > كلمات مرور التطبيقات (App Passwords) > أنشئ كلمة مرور باسم "Nextjs Store" وضعها هنا
SMTP_PASS="xxxx xxxx xxxx xxxx"

# بدائل متوافقة: GOOGLE_EMAIL يعادل SMTP_USER و GOOGLE_APP_PASSWORD يعادل SMTP_PASS
# GOOGLE_EMAIL="you@gmail.com"
# GOOGLE_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# اسم وعنوان المرسل الظاهر في الرسالة (مطلوب، وإلا يُستخدم SMTP_USER تلقائياً)
EMAIL_FROM="Affaire DZ <you@gmail.com>"
