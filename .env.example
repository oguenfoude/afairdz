# البريد المستلم لإشعارات الطلبات والطلبات المتروكة
ADMIN_EMAIL="kalijeogo@gmail.com, have07102@gmail.com"

# خادم البريد (SMTP) - مثال Gmail:
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"

# حساب بريدك Gmail المرسل
SMTP_USER="oguenfoude@gmail.com"

# كلمة مرور التطبيقات من جوجل (Google App Password) - مكونة من 16 حرفاً
# للحصول عليها: ادخل على حساب Google الخاص بك > الأمان (Security) > التحقق بخطوتين (2-Step Verification) > كلمات مرور التطبيقات (App Passwords) > أنشئ كلمة مرور باسم "Nextjs Store" وضعها هنا
SMTP_PASS="xxxx xxxx xxxx xxxx"

# اسم وعنوان المرسل الظاهر في الرسالة
EMAIL_FROM="متجر الساعات الفاخرة الجزائر <oguenfoude@gmail.com>"
